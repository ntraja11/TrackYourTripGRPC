<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TrackYourTripGrpc.Maui.Pages.Account.MainPage"
             Shell.NavBarIsVisible="False"
             >

    <ScrollView>
        <VerticalStackLayout
            VerticalOptions="Center"
            Spacing="20">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />

            

            <Label
                Text="Welcome to Track Your Trip!"
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level2"
                SemanticProperties.Description="Welcome to Track Your Trip" />

            <ActivityIndicator IsRunning="True" VerticalOptions="Center" HorizontalOptions="Center"/>
            
            <Label Text="Checking Authentication ..." HorizontalOptions="Center"/>

            
            
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
