<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mct="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             x:Class="TrackYourTripGrpc.Maui.App"              
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--<Style TargetType="NavigationPage">
                <Setter Property="BarBackgroundColor" Value="BurlyWood" />
                <Setter Property="BarTextColor" Value="Brown" />
                <Setter Property="BackgroundColor" Value="Beige" />
                <Setter Property="Title" Value="Trip Management" />
            </Style>-->

            <Style TargetType="ContentPage">
                <Setter Property="Behaviors">
                    <mct:StatusBarBehavior StatusBarColor="{AppThemeBinding Light={StaticResource Secondary}, 
                        Dark={StaticResource BackgroundDark}}" StatusBarStyle="Default" />
                </Setter>
            </Style>
            
            
            <Style TargetType="VerticalStackLayout" >
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

         
            <Style x:Key="MyLabelText" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor"
                    Value="{AppThemeBinding Light={StaticResource PrimaryText},
                                     Dark={StaticResource TextDark}}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>


            <Style x:Key="EntryUnderlineBorder" TargetType="Border">
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="Stroke"
                    Value="{AppThemeBinding Light={StaticResource SecondaryDark},
                                     Dark={StaticResource PrimaryLight}}" />
                <Setter Property="StrokeShape" Value="Rectangle" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <Style x:Key="EntryText" TargetType="Entry">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource BackgroundDark},
                                     Dark={StaticResource Secondary}}" />
            </Style>

            <Style x:Key="LabelTextBold" TargetType="Label" 
                BasedOn="{StaticResource MyLabelText}">
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <!--<Style TargetType="Label" BasedOn="{StaticResource MyLabelText}" />
            <Style TargetType="Entry" BasedOn="{StaticResource EntryText}" />-->

        </ResourceDictionary>

    </Application.Resources>
</Application>
