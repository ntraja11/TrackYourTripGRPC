<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TrackYourTripGrpc.Maui"
             x:Class="TrackYourTripGrpc.Maui.App"              
             >
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--<Style TargetType="NavigationPage">
                <Setter Property="BarBackgroundColor" Value="BurlyWood" />
                <Setter Property="BarTextColor" Value="Brown" />
                <Setter Property="BackgroundColor" Value="Beige" />
                <Setter Property="Title" Value="Trip Management" />
            </Style>-->

            <Style TargetType="NavigationPage">
                <Setter Property="BarBackgroundColor" Value="{StaticResource Primary}" />
                <Setter Property="BarTextColor" Value="{StaticResource PrimaryText}" />
                <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
                <Setter Property="IconColor" Value="{StaticResource PrimaryText}" />
                <Setter Property="Title" Value="Trip Management" />                
            </Style>
            
            <Style TargetType="VerticalStackLayout" >
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style x:Key="MyLabelText" TargetType="Label">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
                <Setter Property="VerticalOptions" Value="Center" />
                <Setter Property="LineBreakMode" Value="WordWrap" />
            </Style>

            <Style x:Key="EntryText" TargetType="Entry">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="TextColor" Value="{StaticResource PrimaryText}" />
                <Setter Property="VerticalOptions" Value="Center" />
            </Style>

            <Style x:Key="LabelTextBold" TargetType="Label" 
                BasedOn="{StaticResource MyLabelText}">
                <Setter Property="FontAttributes" Value="Bold" />
            </Style>

            <Style TargetType="Label" BasedOn="{StaticResource MyLabelText}" />
            <Style TargetType="Entry" BasedOn="{StaticResource EntryText}" />

        </ResourceDictionary>

    </Application.Resources>
</Application>
