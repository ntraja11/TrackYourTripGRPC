<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TrackYourTripGrpc.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:accountPages="clr-namespace:TrackYourTripGrpc.Maui.Pages.Account"
    xmlns:tripPages="clr-namespace:TrackYourTripGrpc.Maui.Pages.Trip"
    Title="TrackYourTripGrpc.Maui"
    Shell.FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{StaticResource Primary}"
    >
    

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto">
            <Label Text="Track Your Trip"
               VerticalOptions="Center" FontSize="24" />

            <Button Text="Logout" Padding="5" Margin="0,0,15,0" x:Name="LogoutButton"
                FontSize="18" Clicked="LogoutButton_Clicked" Grid.Column="1" />

            <!--<Button Text="Logout" Padding="5" Margin="0,0,15,0" x:Name="LogoutButton"
    FontSize="18" Command="{Binding LogoutCommand}" Grid.Column="1" />-->
        </Grid>
    </Shell.TitleView>


    <ShellContent
        Title="Loading"
        ContentTemplate="{DataTemplate accountPages:MainPage}"
        Route="MainPage" />

    <ShellContent
        ContentTemplate="{DataTemplate accountPages:LoginPage}"
        Route="LoginPage" />

    <ShellContent
        ContentTemplate="{DataTemplate accountPages:RegisterPage}"
        Route="RegisterPage" />

    <ShellContent
        ContentTemplate="{DataTemplate tripPages:TripsPage}"
        Route="TripsPage" />

  

</Shell>
